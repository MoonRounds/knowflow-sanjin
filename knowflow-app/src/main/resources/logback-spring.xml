<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- correlationId 由 CorrelationIdFilter 写入 MDC；%X{correlationId} 使同一请求的日志可关联。 -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml" />

  <appender name="CONSOLE_WITH_CORRELATION" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>
        %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} [correlationId=%X{correlationId:-}] - %msg%n
      </pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE_WITH_CORRELATION" />
  </root>
</configuration>
