# KnowFlow Environment Variables
# Copy this file to .env and fill in your local values.
# .env is git-ignored — never commit real secrets.

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=knowflow
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root

# Server (宿主机映射到 8080)
APP_PORT=8080

# Redis (Chat Memory projection)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# RabbitMQ (async ProcessingTask delivery)
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Qdrant (vector index)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=knowflow_dense_v1

# Embedding (system-level, not shown in ModelConfig page)
KNOWFLOW_EMBEDDING_MODEL=text-embedding-v4
KNOWFLOW_EMBEDDING_DIMENSIONS=1024
# 留空则索引任务会失败并重试；仅配置 base-url 而未提供 api-key 时，启动跳过引导 seed，
# 需在「系统设置 → Embedding」首次保存时填写 API Key。真实使用必须提供：
# KNOWFLOW_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KNOWFLOW_EMBEDDING_API_KEY=<real-key>
KNOWFLOW_EMBEDDING_BASE_URL=
KNOWFLOW_EMBEDDING_API_KEY=

# Application secret master key (Base64-encoded AES-256) — used to encrypt ModelConfig API Keys.
# REQUIRED at startup once ModelConfig encryption is active. Generate locally, never commit:
#   openssl rand -base64 32
KNOWFLOW_SECURITY_MASTER_KEY=
KNOWFLOW_SECURITY_ENCRYPTION_VERSION=1

# Frontend / document storage
FRONTEND_PORT=5173
KNOWFLOW_DOCUMENT_STORAGE_ROOT=knowflow-data/files
